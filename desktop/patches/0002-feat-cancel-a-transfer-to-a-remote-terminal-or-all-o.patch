+/// The card's header: how far the list has come.
+pub fn title(transfers: &Transfers, machine: &str) -> String {
+    let count = |f: fn(&State) -> bool| transfers.items.iter().filter(|i| f(&i.state)).count();
+    let done = count(|s| *s == State::Done);
+    let failed = count(|s| matches!(s, State::Failed(_)));
+    let cancelled = count(|s| *s == State::Cancelled);
+    if transfers.busy() {
+        let left = count(|s| matches!(s, State::Queued | State::Sending { .. }));
+        let count = transfers.items.len() - cancelled;
+        return format!("Sending {} of {count} to {machine}", count - left + 1);
+    }
+    let mut parts = vec![format!("Sent {done}")];
+    if cancelled > 0 {
+        parts.push(format!("cancelled {cancelled}"));
+    }
+    if failed > 0 {
+        parts.push(format!("failed {failed}"));
+    }
+    format!("{} to {machine}", parts.join(", "))
 }
 
