+
+    /// Item `i`'s `hc put` ended with `sent`.
+    pub fn finish(&mut self, i: usize, sent: Result<String, String>) -> Finish {
+        if self.current.as_ref().is_some_and(|(at, _)| *at == i) {
+            self.current = None;
+        }
+        let Some(item) = self.items.get_mut(i) else { return Finish::Nothing };
+        if item.state == State::Cancelled {
+            return item.there.take().map_or(Finish::Nothing, Finish::Remove);
+        }
+        match sent {
+            Ok(there) => {
+                item.state = State::Done;
+                Finish::Paste(there)
+            }
+            Err(why) => {
+                item.state = State::Failed(why);
+                Finish::Nothing
+            }
+        }
+    }
+
+    /// Cancels item `i` if it is queued or sending; a sending one's hc is killed.
+    pub fn cancel(&mut self, i: usize) {
+        let Some(item) = self.items.get_mut(i) else { return };
+        if !matches!(item.state, State::Queued | State::Sending { .. }) {
+            return;
+        }
+        item.state = State::Cancelled;
+        if let Some((at, stop)) = &self.current
+            && *at == i
+        {
+            stop.stop();
+        }
     }
 
