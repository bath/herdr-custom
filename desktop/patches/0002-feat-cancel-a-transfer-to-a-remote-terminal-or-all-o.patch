+/// Removes what part of a cancelled item reached the machine of terminal `addr`.
+/// `there` comes only from hc's own progress for that item.
+pub fn remove_there(addr: &str, there: &str) {
+    let Some((machine, _)) = addr.split_once('/') else { return };
+    if !there.starts_with('/') || there.trim_end_matches('/').is_empty() {
+        return;
+    }
+    let _ = crate::spawn::command(crate::core_bin::path())
+        .args(["exec", "--on", machine, "--", "rm", "-rf", "--", there])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status();
+}
