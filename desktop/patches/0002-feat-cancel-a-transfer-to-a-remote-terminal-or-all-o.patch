+    /// hc's progress for item `i`. Where it lands is kept even after a cancel.
+    pub fn progress(&mut self, i: usize, sent: u64, total: Option<u64>, there: Option<String>) {
+        let Some(item) = self.items.get_mut(i) else { return };
+        if there.is_some() {
+            item.there = there;
+        }
+        if let State::Sending { .. } = item.state {
+            item.state = State::Sending { sent, total };
