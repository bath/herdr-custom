+/// Stops one running `hc put`: kills it, or the next one it would start.
+#[derive(Clone, Default)]
+pub struct Stop(Arc<Mutex<(bool, Option<Child>)>>);
+
+impl Stop {
+    pub fn stop(&self) {
+        let mut held = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+        held.0 = true;
+        if let Some(child) = held.1.as_mut() {
+            let _ = child.kill();
+        }
+    }
+
+    fn stopped(&self) -> bool {
+        self.0.lock().unwrap_or_else(PoisonError::into_inner).0
+    }
+
+    /// Keeps `child` to kill; a stop that came first kills it at once.
+    fn hold(&self, mut child: Child) {
+        let mut held = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+        if held.0 {
+            let _ = child.kill();
+        }
+        held.1 = Some(child);
+    }
+
+    fn take(&self) -> Option<Child> {
+        self.0.lock().unwrap_or_else(PoisonError::into_inner).1.take()
+    }
+}
