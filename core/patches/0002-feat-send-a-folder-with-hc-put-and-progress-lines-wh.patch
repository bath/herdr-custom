@@ -47,6 +47,31 @@ fn clean(name: &str) -> String {
     if safe.is_empty() { "file".into() } else { safe }
 }
 
+/// The folder `folder` ("a/b") under `dir`, made if missing, every part made
+/// safe; with `fresh`, its first part is a new folder (`a-2`, ... when taken).
+/// Its path, and the folder as used ("a-2/b").
+pub fn folder(dir: &Path, folder: &str, fresh: bool) -> std::io::Result<(PathBuf, String)> {
+    let mut parts: Vec<String> = folder.split(['/', '\\']).filter(|p| !p.is_empty()).map(clean).collect();
+    if parts.is_empty() {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "no folder name"));
+    }
+    std::fs::create_dir_all(dir)?;
+    if fresh {
+        let first = parts[0].clone();
+        for n in 1.. {
+            parts[0] = if n == 1 { first.clone() } else { format!("{first}-{n}") };
+            match std::fs::create_dir(dir.join(&parts[0])) {
+                Ok(()) => break,
+                Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                Err(e) => return Err(e),
+            }
+        }
+    }
+    let path = parts.iter().fold(dir.to_path_buf(), |path, part| path.join(part));
+    std::fs::create_dir_all(&path)?;
+    Ok((path, parts.join("/")))
+}
+
 /// Adds `bytes` to the end of `name`, a file an earlier put wrote in `dir`;
 /// its path and its size now.
 pub fn append(dir: &Path, name: &str, bytes: &[u8]) -> std::io::Result<(PathBuf, u64)> {
@@ -93,4 +118,17 @@ mod tests {
         assert_eq!(clean("../../etc/pass wd.png"), "pass_wd.png");
         assert_eq!(clean(".."), "file");
     }
+
+    #[test]
+    fn folders_stay_inside_and_a_fresh_one_never_mixes_with_an_old_one() {
+        let root = std::env::temp_dir().join(format!("hc-put-folder-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let (path, used) = folder(&root, "rom data/../sub", true).unwrap();
+        assert_eq!(used, "rom_data/file/sub");
+        assert_eq!(path, root.join("rom_data/file/sub"));
+        assert_eq!(folder(&root, "rom data", true).unwrap().1, "rom_data-2", "a second drop gets its own folder");
+        assert_eq!(folder(&root, "rom_data/sub", false).unwrap().1, "rom_data/sub", "later files join the first");
+        assert!(folder(&root, "//", false).is_err());
+        std::fs::remove_dir_all(&root).unwrap();
+    }
 }
diff --git a/crates/herdr-core/tests/put.rs b/crates/herdr-core/tests/put.rs
index cb9c03d..8c978e9 100644
--- a/crates/herdr-core/tests/put.rs
+++ b/crates/herdr-core/tests/put.rs
@@ -62,3 +62,43 @@ fn drop_dir_takes_every_file_and_keeps_it() {
     s.json(&["rm", &t]);
     assert!(drop.join("claims.csv").exists(), "kept after its terminal is gone");
 }
+
+#[test]
+fn a_folder_goes_whole_into_a_new_folder_with_progress() {
+    let s = Session::new();
+    let drop = s.root.join("file-drop");
+    std::fs::create_dir_all(s.root.join("config/herdr-core")).unwrap();
+    std::fs::write(
+        s.root.join("config/herdr-core/config.toml"),
+        format!("drop_dir = {:?}\n", drop.display().to_string()),
+    )
+    .unwrap();
+    let src = s.root.join("rom data");
+    std::fs::create_dir_all(src.join("photos/site 1")).unwrap();
+    let big: Vec<u8> = (0..9 << 20).map(|i| (i % 251) as u8).collect();
+    std::fs::write(src.join("claims.csv"), b"a,b\n1,2\n").unwrap();
+    std::fs::write(src.join("photos/site 1/roof.jpg"), &big).unwrap();
+    std::fs::write(src.join("empty.txt"), b"").unwrap();
+    let t = run(&s, &["sleep", "100"]);
+
+    let out = s.hc(&["--json", "put", "--progress", &t, src.to_str().unwrap()]);
+    assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    let got: serde_json::Value = serde_json::from_slice(&out.stdout).unwrap();
+    let total = 8 + big.len() as u64;
+    assert_eq!(got["path"].as_str().unwrap(), drop.join("rom_data").display().to_string(), "{got}");
+    assert_eq!((got["files"].as_u64(), got["bytes"].as_u64()), (Some(3), Some(total)), "{got}");
+    assert_eq!(std::fs::read(drop.join("rom_data/claims.csv")).unwrap(), b"a,b\n1,2\n");
+    assert!(std::fs::read(drop.join("rom_data/photos/site_1/roof.jpg")).unwrap() == big, "kept in its place, whole");
+    assert_eq!(std::fs::read(drop.join("rom_data/empty.txt")).unwrap(), b"");
+
+    // Progress counts up to the folder's total, naming the file it is on.
+    let lines: Vec<serde_json::Value> =
+        String::from_utf8_lossy(&out.stderr).lines().map(|l| serde_json::from_str(l).unwrap()).collect();
+    let sent: Vec<u64> = lines.iter().map(|l| l["progress"]["sent"].as_u64().unwrap()).collect();
+    assert!(sent.windows(2).all(|w| w[0] <= w[1]) && sent.last() == Some(&total), "{sent:?}");
+    assert!(lines.iter().all(|l| l["progress"]["total"].as_u64() == Some(total)));
+    assert!(lines.iter().any(|l| l["progress"]["file"] == "photos/site 1/roof.jpg"));
+
+    let again = s.json(&["put", &t, src.to_str().unwrap()]);
+    assert_eq!(again["path"].as_str().unwrap(), drop.join("rom_data-2").display().to_string(), "never mixed: {again}");
+}
