 /// A request as the JSON the API takes.
+type Call<'a> = dyn Fn(&str, Value) -> Result<Value, RpcError> + 'a;
+
+fn unreadable(path: &std::path::Path, e: std::io::Error) -> RpcError {
+    RpcError::new("usage", format!("cannot read {}: {e}", path.display()), "")
+}
+
+fn file_name(path: &std::path::Path) -> String {
+    path.file_name().unwrap_or(path.as_os_str()).to_string_lossy().into_owned()
+}
+
+/// `hc put --progress`: one line on stderr per piece, for the whole file or
+/// folder being sent (`sent` of `total` bytes) and the file in it now.
+fn progress_line(sent: u64, total: u64, file: &str) {
+    eprintln!("{}", json!({"progress": {"sent": sent, "total": total, "file": file}}));
+}
+
+/// Sends the file at `local` in pieces of at most MAX_BYTES, one call each:
+/// the first makes the file, the rest add to its end. `sent` hears the bytes
+/// sent so far: 0 first, then after each piece.
+fn put_file(call: &Call, p: &mut PutParams, local: &std::path::Path, sent: &mut dyn FnMut(u64)) -> Result<Value, RpcError> {
+    let mut file = std::fs::File::open(local).map_err(|e| unreadable(local, e))?;
+    p.append = None;
+    let (mut r, mut done) = (Value::Null, 0);
+    sent(0);
+    loop {
+        let mut piece = Vec::new();
+        (&mut file).take(crate::put::MAX_BYTES as u64).read_to_end(&mut piece).map_err(|e| unreadable(local, e))?;
+        if piece.is_empty() && p.append.is_some() {
+            break;
+        }
+        p.data = crate::put::encode(&piece);
+        let got = call("terminal.put", to(&*p))?;
+        p.fresh = false;
+        let path = got["path"].as_str().unwrap_or_default();
+        match &p.append {
+            None => p.append = path.rsplit(['/', '\\']).next().map(str::to_string),
+            // A core from before `append` makes a new file instead.
+            Some(_) if r["path"] != got["path"] => {
+                return Err(RpcError::new(
+                    "unsupported",
+                    format!("{} took only the first part of {}", p.terminal, local.display()),
+                    "update hc on that machine (`hc machine update`), then send it again",
+                ));
+            }
+            Some(_) => {}
+        }
+        done += piece.len() as u64;
+        sent(done);
+        r = got;
+        if piece.len() < crate::put::MAX_BYTES {
+            break;
+        }
+    }
+    Ok(r)
+}
+
+/// Sends every file in the folder at `local` (links are not followed), each
+/// in its place, into one new folder there; answers with that folder's path.
+fn put_folder(call: &Call, mut p: PutParams, local: &std::path::Path) -> Result<Value, RpcError> {
+    let mut files = Vec::new();
+    folder_files(local, std::path::Path::new(""), &mut files).map_err(|e| unreadable(local, e))?;
+    if files.is_empty() {
+        return Err(RpcError::new("usage", format!("{} has no files to send", local.display()), ""));
+    }
+    let total: u64 = files.iter().map(|(_, _, len)| len).sum();
+    let (name, progress) = (file_name(local), p.progress);
+    let (mut root, mut path, mut before) = (None::<String>, String::new(), 0);
+    for (file, inside, len) in &files {
+        let base = root.clone().unwrap_or_else(|| name.clone());
+        let parent = inside.parent().map(|d| d.to_string_lossy().replace('\\', "/")).filter(|d| !d.is_empty());
+        p.folder = Some(parent.map_or(base.clone(), |d| format!("{base}/{d}")));
+        p.fresh = root.is_none();
+        p.name = file.to_string_lossy().into_owned();
+        let shown = inside.to_string_lossy().into_owned();
+        let got = put_file(call, &mut p, file, &mut |sent| {
+            if progress {
+                progress_line(before + sent, total, &shown);
+            }
+        })?;
+        let Some(used) = got["folder"].as_str() else {
+            return Err(RpcError::new(
+                "unsupported",
+                format!("{} can't take a folder", p.terminal),
+                "update hc on that machine (`hc machine update`), then send it again",
+            ));
+        };
+        if root.is_none() {
+            root = used.split('/').next().map(str::to_string);
+            // The new folder: the first file's path, less its place inside.
+            let first = std::path::Path::new(got["path"].as_str().unwrap_or_default());
+            path = first.ancestors().nth(inside.components().count()).unwrap_or(first).display().to_string();
+        }
+        before += len;
+    }
+    Ok(json!({"path": path, "bytes": total, "files": files.len(), "folder": root}))
+}
+
+/// The files under `dir`/`inside`, sorted, with their place in `dir` and size.
+fn folder_files(
+    dir: &std::path::Path,
+    inside: &std::path::Path,
+    out: &mut Vec<(std::path::PathBuf, std::path::PathBuf, u64)>,
+) -> std::io::Result<()> {
+    let mut entries: Vec<_> = std::fs::read_dir(dir.join(inside))?.collect::<Result<_, _>>()?;
+    entries.sort_by_key(|e| e.file_name());
+    for entry in entries {
+        let kind = entry.file_type()?;
+        let place = inside.join(entry.file_name());
+        if kind.is_dir() {
+            folder_files(dir, &place, out)?;
+        } else if kind.is_file() {
+            out.push((entry.path(), place, entry.metadata()?.len()));
+        }
+    }
+    Ok(())
+}
+
 fn to(params: &impl serde::Serialize) -> Value {
     serde_json::to_value(params).unwrap_or_default()
 }
