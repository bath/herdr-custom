-/// Writes `bytes` as `name` (or `name-2.ext`, ... when taken) beside terminal `id`.
-pub fn stage(state: &Path, id: u32, name: &str, bytes: &[u8]) -> std::io::Result<PathBuf> {
-    let dir = dir(state, id);
-    std::fs::create_dir_all(&dir)?;
+/// Adds `bytes` to the end of `name`, a file an earlier put wrote in `dir`;
+/// its path and its size now.
+pub fn append(dir: &Path, name: &str, bytes: &[u8]) -> std::io::Result<(PathBuf, u64)> {
+    if clean(name) != name {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "not a name a put returned"));
+    }
+    let path = dir.join(name);
+    let mut f = std::fs::OpenOptions::new().append(true).open(&path)?;
+    std::io::Write::write_all(&mut f, bytes)?;
+    Ok((path, f.metadata()?.len()))
+}
+
+/// Writes `bytes` as `name` (or `name-2.ext`, ... when taken) in `dir`.
+pub fn stage(dir: &Path, name: &str, bytes: &[u8]) -> std::io::Result<PathBuf> {
+    std::fs::create_dir_all(dir)?;
     let name = clean(name);
     let (stem, ext) = match name.rsplit_once('.').filter(|(stem, _)| !stem.is_empty()) {
         Some((stem, ext)) => (stem.to_string(), format!(".{ext}")),
