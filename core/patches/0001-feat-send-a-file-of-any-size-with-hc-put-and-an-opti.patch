diff --git a/crates/herdr-core/src/cli.rs b/crates/herdr-core/src/cli.rs
index 2035dd5..b32eaa4 100644
--- a/crates/herdr-core/src/cli.rs
+++ b/crates/herdr-core/src/cli.rs
@@ -475,10 +475,38 @@ fn run(cmd: Option<Cmd>, json: bool, asked: bool) -> Result<Option<Out>, RpcErro
             Out { json: r, human }
         }
         Cmd::Put(mut p) => {
-            let bytes = std::fs::read(&p.name)
-                .map_err(|e| RpcError::new("usage", format!("cannot read {}: {e}", p.name), ""))?;
-            p.data = crate::put::encode(&bytes);
-            let r = call("terminal.put", to(&p))?;
+            let local = p.name.clone();
+            let cannot = |e: std::io::Error| RpcError::new("usage", format!("cannot read {local}: {e}"), "");
+            let mut file = std::fs::File::open(&local).map_err(cannot)?;
+            // Every file goes in pieces of at most MAX_BYTES, one call each:
+            // the first makes the file, the rest add to its end.
+            let mut r = Value::Null;
+            loop {
+                let mut piece = Vec::new();
+                (&mut file).take(crate::put::MAX_BYTES as u64).read_to_end(&mut piece).map_err(cannot)?;
+                if piece.is_empty() && p.append.is_some() {
+                    break;
+                }
+                p.data = crate::put::encode(&piece);
+                let got = call("terminal.put", to(&p))?;
+                let path = got["path"].as_str().unwrap_or_default();
+                match &p.append {
+                    None => p.append = path.rsplit(['/', '\\']).next().map(str::to_string),
+                    // A core from before `append` makes a new file instead.
+                    Some(_) if r["path"] != got["path"] => {
+                        return Err(RpcError::new(
+                            "unsupported",
+                            format!("{} took only the first part of {local}", p.terminal),
+                            "update hc on that machine (`hc machine update`), then send it again",
+                        ));
+                    }
+                    Some(_) => {}
+                }
+                r = got;
+                if piece.len() < crate::put::MAX_BYTES {
+                    break;
+                }
+            }
             let human = r["path"].as_str().unwrap_or_default().to_string();
             Out { json: r, human }
         }
