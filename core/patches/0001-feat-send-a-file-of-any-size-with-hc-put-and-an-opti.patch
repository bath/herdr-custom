diff --git a/crates/herdr-core/src/api.rs b/crates/herdr-core/src/api.rs
index 89711d6..615169c 100644
--- a/crates/herdr-core/src/api.rs
+++ b/crates/herdr-core/src/api.rs
@@ -554,9 +554,13 @@ async fn terminal_put(core: Ctx<'_>, p: PutParams) -> Result<PutResult, RpcError
             "nothing there to read it",
         ));
     }
-    let path = crate::put::stage(&core.paths.state, id, &p.name, &bytes)
-        .map_err(|e| RpcError::internal(format!("cannot write the file: {e}")))?;
-    Ok(PutResult { path: path.display().to_string(), bytes: bytes.len() })
+    let dir = core.settings().drop_dir()?.unwrap_or_else(|| crate::put::dir(&core.paths.state, id));
+    let (path, size) = match &p.append {
+        None => crate::put::stage(&dir, &p.name, &bytes).map(|path| (path, bytes.len() as u64)),
+        Some(name) => crate::put::append(&dir, name, &bytes),
+    }
+    .map_err(|e| RpcError::internal(format!("cannot write the file: {e}")))?;
+    Ok(PutResult { path: path.display().to_string(), bytes: size as usize })
 }
 
