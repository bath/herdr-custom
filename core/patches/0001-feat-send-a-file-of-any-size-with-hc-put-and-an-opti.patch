     s.json(&["rm", &here]);
     assert!(!std::path::Path::new(path).exists(), "removed with the terminal");
 
-    std::fs::write(&file, vec![0u8; 9 << 20]).unwrap();
-    assert_eq!(
-        s.err(&["--json", "put", &there, file.to_str().unwrap()]).1["error"]["kind"],
-        "invalid_params",
-        "too big"
-    );
-    // Too big even to carry to rohan: refused here, and the line lives on.
-    std::fs::write(&file, vec![0u8; 13 << 20]).unwrap();
-    assert_eq!(s.err(&["--json", "put", &there, file.to_str().unwrap()]).1["error"]["kind"], "invalid_params");
-    std::fs::write(&file, b"small").unwrap();
-    s.json(&["put", &there, file.to_str().unwrap()]);
+    // Any size goes the same way: in pieces, whole on arrival, one path.
+    for size in [0, 8 << 20, 20 << 20] {
+        let big: Vec<u8> = (0..size).map(|i| (i % 251) as u8).collect();
+        std::fs::write(&file, &big).unwrap();
+        let got = s.json(&["put", &there, file.to_str().unwrap()]);
+        assert_eq!(got["bytes"].as_u64(), Some(size as u64), "{got}");
+        assert!(std::fs::read(got["path"].as_str().unwrap()).unwrap() == big, "{size} bytes arrive whole");
+    }
+}
+
+#[test]
+fn drop_dir_takes_every_file_and_keeps_it() {
+    let s = Session::new();
+    let drop = s.root.join("file-drop");
+    std::fs::create_dir_all(s.root.join("config/herdr-core")).unwrap();
+    std::fs::write(
+        s.root.join("config/herdr-core/config.toml"),
+        format!("drop_dir = {:?}\n", drop.display().to_string()),
+    )
+    .unwrap();
+    let file = s.root.join("claims.csv");
+    std::fs::write(&file, b"a,b\n1,2\n").unwrap();
+
+    let t = run(&s, &["sleep", "100"]);
+    let got = s.json(&["put", &t, file.to_str().unwrap()]);
+    assert_eq!(got["path"].as_str().unwrap(), drop.join("claims.csv").display().to_string(), "{got}");
+    s.json(&["kill", &t]);
+    s.json(&["rm", &t]);
+    assert!(drop.join("claims.csv").exists(), "kept after its terminal is gone");
 }
